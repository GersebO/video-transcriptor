# Tamaño del modelo Whisper: tiny | base | small | medium | large-v3
TRANSCRIPTOR_MODEL_SIZE=small
# auto | cpu | cuda
TRANSCRIPTOR_DEVICE=auto
# int8 en CPU, float16 en GPU
TRANSCRIPTOR_COMPUTE_TYPE=int8
# Vacío = detección automática del idioma (ej.: es, en)
TRANSCRIPTOR_DEFAULT_LANGUAGE=
# Tamaño máximo de subida en MB. 0 = sin límite (recomendado para reuniones largas)
TRANSCRIPTOR_MAX_UPLOAD_MB=0
# Dónde se guardan los pesos del modelo
# TRANSCRIPTOR_MODELS_DIR=~/.cache/transcriptor
# Carpeta de temporales y subidas; apúntala a un disco con mucho espacio
# TRANSCRIPTOR_TEMP_DIR=D:/transcriptor-tmp
# Base de datos SQLite de la cola de trabajos de la API
# TRANSCRIPTOR_JOBS_DB=~/.cache/transcriptor/jobs.db
